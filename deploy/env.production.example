# ======================================================================
# DocMind AI — .env de PRODUÇÃO para a demonstração pública
# O deploy/bootstrap.sh gera o .env real a partir deste modelo, trocando os
# marcadores __...__ por segredos aleatórios. Nunca versione o .env real.
# ======================================================================

# --- Endereço público ----------------------------------------------------
# Domínio (ou <ip-com-hifens>.sslip.io) que aponta para este servidor. O Caddy emite o certificado.
SITE_ADDRESS=__SITE_ADDRESS__
APP_BASE_URL=https://__SITE_ADDRESS__
CORS_ORIGINS=https://__SITE_ADDRESS__
HTTP_PORT=80
HTTPS_PORT=443

# --- Aplicação -------------------------------------------------------------
APP_ENV=production
APP_NAME=DocMind AI
SECRET_KEY=__SECRET_KEY__
COOKIE_SECURE=true
SESSION_TTL_HOURS=24
LOG_LEVEL=INFO

# --- Modo demonstração -------------------------------------------------------
# Aviso fixo de "ambiente de demonstração" e botão "Carregar documentos de exemplo".
DEMO_MODE=true
REGISTRATION_ENABLED=true
# Cada visitante ganha um workspace isolado com estes limites (o admin dele pode ver em Administração).
NEW_WORKSPACE_MAX_DOCUMENTS=10
NEW_WORKSPACE_MAX_STORAGE_MB=25
NEW_WORKSPACE_MONTHLY_TOKEN_BUDGET=200000
# Conversas, análises e histórico de pesquisa apagados após N dias (retenção diária do worker).
NEW_WORKSPACE_RETENTION_DAYS=7
# Teto diário somando todos os visitantes: protege a quota da chave. Ajuste aos limites do seu
# projeto no AI Studio (na avaliação registrada, uma pergunta consumiu ~1,9 mil tokens em média).
GLOBAL_DAILY_TOKEN_BUDGET=1000000

# --- PostgreSQL + pgvector ------------------------------------------------------
POSTGRES_USER=docmind
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=docmind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Armazenamento privado (MinIO interno, sem porta publicada) -----------------
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=docmind
MINIO_ROOT_PASSWORD=__MINIO_ROOT_PASSWORD__
MINIO_BUCKET=docmind-documents
MINIO_SECURE=false

# --- Provedores de IA (a chave fica só aqui, no servidor) -----------------------
EMBEDDING_PROVIDER=__PROVIDER__
LLM_PROVIDER=__PROVIDER__
GEMINI_API_KEY=__GEMINI_API_KEY__
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=
LLM_ALLOWED_MODELS=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=4
PROVIDER_RETRY_BASE_SECONDS=1
PROVIDER_RETRY_MAX_SECONDS=30
GEMINI_THINKING_LEVEL=
GEMINI_APPLY_TEMPERATURE=false

# --- E-mail (vazio = e-mails só no log; recuperação de senha indisponível para visitantes) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=DocMind AI <no-reply@__SITE_ADDRESS__>
MAIL_USE_TLS=true

# --- Limites de upload, processamento e uso (mais restritos que o padrão) -------
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=40
MAX_CONCURRENT_UPLOADS_PER_USER=3
ANALYSIS_MAX_INPUT_TOKENS=40000
ANALYSIS_MAX_OUTPUT_TOKENS=1200
MAX_QUESTION_CHARS=1000
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_QUESTIONS_PER_HOUR=20
RATE_LIMIT_UPLOADS_PER_HOUR=10
OCR_ENABLED=false
