# Caddy — produção: serve o frontend e faz proxy da API.
# SITE_ADDRESS vazio => ":80" (HTTP simples, atrás de outro proxy ou para teste local).
# SITE_ADDRESS=demo.seu-dominio.com => HTTPS automático (Let's Encrypt), redirecionamento de HTTP
# para HTTPS e renovação do certificado; exige DNS apontando para o servidor e portas 80/443 abertas.
{$SITE_ADDRESS::80} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		# Ignorado pelos navegadores em HTTP simples; vale quando o site é servido via HTTPS
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# PDF.js usa workers e blobs; fontes do Google Fonts; sem scripts externos
		Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
