{
  "name": "@docmind/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DocMind AI — frontend (React + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
