# ======================================================================
# DocMind AI — variáveis de ambiente (copie para .env e ajuste)
# Nunca versione o arquivo .env real.
# ======================================================================

# --- Aplicação ---------------------------------------------------------
APP_ENV=development
APP_NAME=DocMind AI
# Chave usada para assinar cookies/tokens. Gere com: openssl rand -hex 32
SECRET_KEY=change-me-please-generate-a-random-64-hex-string
# Origens permitidas (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Em produção (HTTPS) defina como true
COOKIE_SECURE=false
SESSION_TTL_HOURS=72
LOG_LEVEL=INFO

# --- PostgreSQL + pgvector --------------------------------------------
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind
POSTGRES_DB=docmind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# URL completa usada pelo backend (sobrescreve as variáveis acima se definida)
# DATABASE_URL=postgresql+psycopg://docmind:docmind@postgres:5432/docmind

# --- Redis / Celery ----------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Armazenamento privado ---------------------------------------------
# minio (padrão) | local (apenas desenvolvimento sem Docker) | memory (testes)
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=./data/storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=docmind
MINIO_ROOT_PASSWORD=docmind-minio-secret
MINIO_BUCKET=docmind-documents
MINIO_SECURE=false

# --- Provedores de IA --------------------------------------------------
# Provedores: "openai" (real) ou "fake" (determinístico, apenas testes/dev sem chave)
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Modelos configuráveis — ajuste para modelos disponíveis na sua conta
EMBEDDING_MODEL=text-embedding-3-small
# Dimensão do vetor armazenado no pgvector. Trocar exige reindexação.
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Conta, e-mail e convites -----------------------------------------
# URL pública do frontend (links de recuperação de senha e convites)
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_DAYS=7
# Sem MAIL_HOST os e-mails são apenas registrados no log do servidor (desenvolvimento)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=DocMind AI <no-reply@docmind.local>
MAIL_USE_TLS=true

# --- Provedores e OCR ----------------------------------------------------
# Modelos de linguagem que administradores podem escolher por workspace (separados por vírgula)
LLM_ALLOWED_MODELS=
# OCR (Tesseract) para PDFs digitalizados: exige o binário e o idioma instalados (ver docs/ocr-evaluation.md)
OCR_ENABLED=false
OCR_LANGUAGE=por
TESSERACT_CMD=

# --- Limites de upload e processamento ---------------------------------
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
MAX_CONCURRENT_UPLOADS_PER_USER=3

# --- RAG: chunking e recuperação ---------------------------------------
CHUNK_TARGET_TOKENS=700
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=100
# Fecha o chunk na troca de página quando ele já tem >= N tokens (citações precisas por página)
CHUNK_RESPECT_PAGES=true
CHUNK_MIN_TOKENS_BEFORE_PAGE_BREAK=200
# Idem para seções lógicas de DOCX/TXT (fronteiras semânticas → limiar menor)
CHUNK_MIN_TOKENS_BEFORE_SECTION_BREAK=80
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SIMILARITY=0.15
MAX_CONTEXT_TOKENS=6000
MAX_OUTPUT_TOKENS=800
# Análises (Fase 4): teto de tokens de entrada por análise, saída máxima e trechos por documento em comparações
ANALYSIS_MAX_INPUT_TOKENS=120000
ANALYSIS_MAX_OUTPUT_TOKENS=1500
ANALYSIS_COMPARE_TOP_K=6
MAX_QUESTION_CHARS=2000

# --- Limites de uso ----------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_QUESTIONS_PER_HOUR=60
RATE_LIMIT_UPLOADS_PER_HOUR=30

# --- Frontend ----------------------------------------------------------
VITE_API_URL=/api/v1
